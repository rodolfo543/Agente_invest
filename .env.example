# Configurações da Foxbit
FOXBIT_API_KEY=sua_foxbit_api_key_publica
FOXBIT_SECRET_KEY=sua_foxbit_secret_key_privada
FOXBIT_CLIENT_ID=seu_client_id_foxbit
FOXBIT_BASE_URL=https://api.foxbit.com.br

# Modo Simulação (True = apenas simular no estado.json / False = enviar ordens reais)
SIMULATION_MODE=True

# Configurações da NVIDIA DeepSeek
NVIDIA_API_KEY=sua_nvidia_api_key_nvapi
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

# Configurações do Telegram
TELEGRAM_BOT_TOKEN=seu_bot_token_telegram
TELEGRAM_CHAT_ID=seu_chat_id_telegram

# Ativos monitorados pelo Bot (separados por vírgula)
TARGET_TICKERS=btcbrl,ethbrl,solbrl
